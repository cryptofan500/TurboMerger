{
  "name": "turbomerger",
  "version": "7.7.0",
  "description": "One-click codebase merger",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cryptofan500/TurboMerger.git"
  },
  "homepage": "https://github.com/cryptofan500/TurboMerger#readme",
  "bugs": {
    "url": "https://github.com/cryptofan500/TurboMerger/issues"
  },
  "engines": {
    "node": ">=22.12 <25",
    "npm": ">=10"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --config src-tauri/tauri.bundle.conf.json",
    "tauri:build:mac": "tauri build --config src-tauri/tauri.bundle.conf.json --target aarch64-apple-darwin",
    "tauri:build:windows": "tauri build --config src-tauri/tauri.bundle.conf.json --bundles nsis",
    "tauri:build:linux": "tauri build --config src-tauri/tauri.bundle.conf.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "format:check": "cargo fmt --all -- --check",
    "clippy": "cargo clippy --workspace --all-targets --all-features --locked -- -D warnings",
    "test:rust": "cargo test --workspace --all-features --locked",
    "version:check": "node scripts/check-version.mjs",
    "check": "npm run version:check && npm run lint && npm run build",
    "verify": "npm run check && npm run format:check && npm run clippy && npm run test:rust",
    "sidecar": "node scripts/build-sidecar.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  },
  "overrides": {
    "chalk": "5.3.0",
    "debug": "4.3.4",
    "ansi-styles": "6.2.1",
    "strip-ansi": "7.1.0"
  }
}
